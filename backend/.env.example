# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/pdfutils server|worker`.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://pdfutils:pdfutils@localhost:5432/pdfutils?sslmode=disable
REDIS_ADDR=localhost:6379

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=pdfutils
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_PATH_STYLE=true
# Leave empty to stream downloads through the API; set to a browser-reachable
# storage endpoint to hand out presigned URLs instead.
S3_PUBLIC_ENDPOINT=

# In dev the web app proxies /v1 to the API, so both public URLs point at Vite.
PUBLIC_URL=http://localhost:5173
WEB_URL=http://localhost:5173
WEB_ORIGINS=http://localhost:5173

JWT_SECRET=dev-only-change-me-dev-only-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated iOS/Android OAuth client ids accepted for /v1/auth/google/token
GOOGLE_MOBILE_CLIENT_IDS=

# Empty SMTP_ADDR logs emails (verification/reset links) instead of sending.
SMTP_ADDR=
MAIL_FROM="PDF Utils <no-reply@localhost>"
