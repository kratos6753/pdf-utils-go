# Copy to terraform.tfvars. Put secrets in environment variables instead:
#   export TF_VAR_dockerhub_token=dckr_pat_...      (Docker Hub, Read, Write, Delete)
#   export TF_VAR_smtp_password=abcdabcdabcdabcd    (Google app password)

region       = "us-east-1"
domain       = "pdf.example.com"
route53_zone = "example.com" # "" if your DNS is elsewhere (saves $0.50/month)

dockerhub_username = "your-dockerhub-user"

# Email through Gmail; leave empty to disable sending.
smtp_username = "you@gmail.com"

# alert_email = "you@example.com"     # free budget alerts
# enable_db_backups = true            # nightly pg_dump to S3, a few cents/month
# github_repository = "your-user/pdf-utils-go"

# google_client_id = "1234-abc.apps.googleusercontent.com"   # + TF_VAR_google_client_secret
