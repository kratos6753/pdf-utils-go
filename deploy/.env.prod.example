DOMAIN=pdf.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters

# Object storage: AWS S3 (leave S3_ENDPOINT empty) or Cloudflare R2
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto).
S3_BUCKET=pdfutils-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_IDS=

SMTP_ADDR=smtp.resend.com:587
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM="PDF Utils <no-reply@pdf.example.com>"
WORKER_CONCURRENCY=4
